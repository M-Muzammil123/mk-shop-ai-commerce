# ── AI E-Commerce Platform — Backend Environment Variables ──
# Copy this file to .env and fill in your values.

# ── Application ──
PROJECT_NAME="AI E-Commerce Platform"
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Supabase (required for production auth) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── AI Provider Configuration ──
OPENAI_API_KEY=
GEMINI_API_KEY=

AI_PROVIDER=openai
RESEARCH_PROVIDER=gemini

OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
GEMINI_MODEL=gemini-1.5-pro

# ── MCP Shopping Gateway ──
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:8001
MCP_AUTH_TOKEN=mk_mcp_auth_token_secret

# ── Defaults ──
DEFAULT_COUNTRY=PK
DEFAULT_CURRENCY=PKR

# ── Payment Gateways (Mock by default) ──
PAYMENT_MODE=mock

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Mail Config ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=app_password
SMTP_FROM=no-reply@aiecommerce.com
